{
  "name": "veil",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "models": "node scripts/fetch-models.mjs",
    "predev": "node scripts/fetch-models.mjs && node scripts/export/fetch-models.mjs",
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "prebuild": "node scripts/fetch-models.mjs && node scripts/export/fetch-models.mjs",
    "build": "vite build",
    "postbuild": "node scripts/sw-manifest.mjs",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "build:android": "vite build && node scripts/android/prepare.mjs && cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/share": "8.0.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "@contentauth/c2pa-web": "0.15.5",
    "@fontsource-variable/figtree": "5.3.0",
    "@fontsource-variable/geist": "5.2.6",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/outfit": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "animejs": "4.2.2",
    "motion": "14.9.0",
    "onnxruntime-web": "1.31.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@napi-rs/canvas": "1.1.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "onnxruntime-node": "1.20.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
