# Google OAuth client ID (Web application) for "Send from my Gmail".
# Google Cloud Console -> APIs & Services -> Credentials -> Create OAuth client ID -> Web application.
# Authorized JavaScript origins: http://localhost:5191 (and your deployed origin)
# Authorized redirect URIs: http://localhost:5191/oauth.html (and https://<deployed>/oauth.html)
# Enable the Gmail API; while the app is in "Testing", add your Gmail as a test user.
VITE_GOOGLE_CLIENT_ID=

# Optional: Google Lens results through SerpApi (server only, never shipped to the browser).
SERPAPI_KEY=
